# ============================================================
# PandoraHR - Variables de Entorno
# ============================================================
NODE_ENV=production
PORT=3002
HOST=0.0.0.0
TZ=America/Caracas

# Base de datos (MariaDB en Coolify)
DB_HOST=
DB_PORT=3306
DB_NAME=pandorahr
DB_USER=
DB_PASSWORD=

# JWT (generar con: openssl rand -hex 64)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# URLs
PUBLIC_URL=https://pandorahr.amaysgroup.com
FRONTEND_URL=https://pandorahr.amaysgroup.com

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pandorahr.amaysgroup.com

# Almacenamiento (logos, membretes) — volumen persistente
STORAGE_PATH=/app/storage
